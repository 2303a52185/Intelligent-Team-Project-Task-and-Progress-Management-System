<%--
  Layout used by dashboard.jsp, projects.jsp, team.jsp, tasks.jsp, board.jsp, reports.jsp, approvals.jsp, admin.jsp and activity.jsp.
  Each page sets these request attributes before including this file:
     activePage    which module the page is (dashboard, projects, ...). app.js only draws that module
     allowedRoles  roles that can open the page, comma separated (server check, on top of the API checks)
  The user comes from the session attribute "user" (a bean with id, name, email and role) set by the login servlet.
--%>
<c:if test="${empty sessionScope.user}"><c:redirect url="/login.jsp"/></c:if>
<c:if test="${not fn:contains(allowedRoles, sessionScope.user.role)}"><c:redirect url="/dashboard.jsp"/></c:if>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Veltrixa | ${pageTitle}</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="${ctx}/css/style.css">
</head>
<%-- c:out escapes quotes and angle brackets so a name can't break the attributes --%>
<body data-mode="app" data-page="${activePage}" data-page-ext=".jsp"
      data-api-base="${ctx}/api" data-login-url="${ctx}/login.jsp"
      data-user-id="<c:out value='${sessionScope.user.id}'/>" data-user-name="<c:out value='${sessionScope.user.name}'/>"
      data-user-email="<c:out value='${sessionScope.user.email}'/>" data-user-role="<c:out value='${sessionScope.user.role}'/>">
  <div id="topLoader" class="top-loader" aria-hidden="true"></div>
  <div id="toastArea" class="toast-container position-fixed top-0 end-0 p-3" aria-live="polite"></div>
<%@ include file="app-shell.jspf" %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="${ctx}/js/config.js"></script>
  <script src="${ctx}/js/permissions.js"></script>
  <script src="${ctx}/js/api.js"></script>   <%-- no mock-server.js here, real fetch calls go to ${ctx}/api --%>
  <script src="${ctx}/js/ui.js"></script>
  <script src="${ctx}/js/app.js"></script>
</body>
</html>
