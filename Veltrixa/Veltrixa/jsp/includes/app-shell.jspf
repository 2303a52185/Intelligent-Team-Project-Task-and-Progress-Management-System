<%-- Shared app shell: sidebar, top bar, page area and dialogs. Same as the #app block and dialogs in the .html pages. --%>
  <div id="app" class="app-shell">
    <aside class="sidebar">
      <a class="brand" href="dashboard.jsp"><span class="brand-mark" aria-label="Veltrixa logo">V</span> Veltrixa</a>
      <div class="workspace-label">WORKSPACE</div>
      <nav id="mainNav" aria-label="Main navigation"></nav>
      <div class="sidebar-user">
        <div class="avatar"><c:out value="${fn:substring(sessionScope.user.name, 0, 1)}"/></div><div class="user-meta"><strong id="sidebarUser"><c:out value="${sessionScope.user.name}"/></strong><small id="sidebarRole"><c:out value="${sessionScope.user.role}"/></small></div>
        <button class="btn btn-sm btn-light ms-auto" id="logoutButton" title="Sign out" aria-label="Sign out">↪</button>
      </div>
    </aside>

    <main class="main-content">
      <header class="topbar">
        <div><div class="eyebrow" id="todayLabel"></div><h1 id="pageHeading">Dashboard</h1><p id="pageSubheading">Your workspace at a glance.</p></div>
        <div class="topbar-actions"><span class="role-chip" id="roleChip"><c:out value="${sessionScope.user.role}"/></span><button class="btn btn-primary d-none" id="topAction">+ New project</button></div>
      </header>
      <div id="alertArea"></div>
      <section id="pageContent"></section>
      <footer>Veltrixa · Intelligent Team Project Task and Progress Management System · Version 2.1</footer>
    </main>
  </div>

  <!-- modal for adding and editing -->
  <div class="modal fade" id="recordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
      <form id="recordForm" novalidate>
        <div class="modal-header"><h2 class="modal-title fs-5" id="modalTitle">Create</h2><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body"><div id="modalFields"></div><div id="formError" class="auth-message error small mt-3" role="alert"></div></div>
        <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" type="submit" id="recordSave">Save</button></div>
      </form>
    </div></div>
  </div>

  <div class="modal fade" id="detailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
      <div class="modal-header"><h2 class="modal-title fs-5" id="detailTitle">Details</h2><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body" id="detailBody"></div>
    </div></div>
  </div>

  <!-- confirm dialog (delete, remove) -->
  <div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm"><div class="modal-content">
      <div class="modal-header"><h2 class="modal-title fs-5" data-confirm-title>Please confirm</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
      <div class="modal-body" data-confirm-message></div>
      <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" data-confirm-yes>Confirm</button></div>
    </div></div>
  </div>

  <!-- review / note dialog -->
  <div class="modal fade" id="promptModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
      <div class="modal-header"><h2 class="modal-title fs-5" data-prompt-title>Add a note</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
      <div class="modal-body"><label class="form-label" data-prompt-label></label><textarea class="form-control" rows="3" maxlength="500" data-prompt-input></textarea><div class="text-danger small mt-1" data-prompt-error></div></div>
      <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" data-prompt-yes>Save</button></div>
    </div></div>
  </div>
